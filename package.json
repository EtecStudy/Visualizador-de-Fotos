{
  "name": "lumina-fotos",
  "private": true,
  "version": "1.0.0",
  "description": "Lumina — visualizador e editor de fotos para Windows com upscale por IA local",
  "author": "Lumina",
  "license": "MIT",
  "type": "module",
  "main": "electron-dist/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "models": "node scripts/copy-models.mjs",
    "electron:compile": "node scripts/build-electron.mjs",
    "desktop": "node scripts/dev-desktop.mjs",
    "desktop:build": "npm run build && npm run electron:compile && electron-builder --win --publish never",
    "postinstall": "node scripts/copy-models.mjs"
  },
  "dependencies": {
    "@tensorflow/tfjs": "4.11.0",
    "@upscalerjs/esrgan-slim": "1.0.0",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "upscaler": "1.0.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "38.8.6",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.9",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.lumina.fotos",
    "productName": "Lumina Fotos",
    "copyright": "Copyright © 2026 Lumina",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "electron-dist/**/*",
      "assets/icon.ico",
      "assets/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lumina Fotos",
      "artifactName": "Lumina-Fotos-${version}-Setup.${ext}"
    },
    "fileAssociations": [
      {
        "ext": [
          "jpg",
          "jpeg",
          "png",
          "webp"
        ],
        "name": "Imagem",
        "role": "Viewer"
      }
    ],
    "zip": {
      "artifactName": "Lumina-Fotos-${version}-portable.${ext}"
    }
  }
}
